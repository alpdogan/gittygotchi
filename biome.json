{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/.wrangler",
			"!!**/dist",
			"!!**/coverage",
			"!!**/pnpm-lock.yaml",
			"!!**/worker-configuration.d.ts",
			"!!**/fixtures",
			"!!**/docs/screenshots",
			"!!**/docs/prototype"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
