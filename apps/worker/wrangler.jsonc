{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gittygotchi",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-08",
	"workers_dev": false,
	"routes": [{ "pattern": "gittygotchi.alpdogan.co", "custom_domain": true }],
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
			"head_sampling_rate": 1
		}
	},
	"cache": {
		"enabled": true
	},
	"exports": {
		"default": { "type": "worker", "cache": { "enabled": false } },
		"PetSvg": { "type": "worker", "cache": { "enabled": true } }
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gittygotchi",
			"database_id": "48dced32-6f18-48fa-9480-fa1a1585186d",
			"preview_database_id": "gittygotchi-local",
			"migrations_dir": "migrations"
		}
	]
}
