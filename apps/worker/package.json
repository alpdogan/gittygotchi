		"@gittygotchi/svg": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.6",
		"typescript": "5.9.3",
		"vitest": "4.1.11",
		"wrangler": "4.130.0"
	}
}
