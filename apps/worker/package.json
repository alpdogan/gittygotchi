{
	"name": "@gittygotchi/worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler d1 migrations apply gittygotchi --local && wrangler dev",
		"deploy": "wrangler deploy",
		"types": "wrangler types",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
	},
	"dependencies": {
